# ============================================================
# ReelRoutes V4 — Test Environment
# Copy to .env.test and fill in test-specific values.
# Uses a separate MongoDB database to avoid polluting local dev.
# ============================================================
ENV=test

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=reelroutes_test

CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# Use mocked/sandboxed keys for tests
OPENAI_API_KEY=sk-test-REPLACE_ME
GOOGLE_PLACES_API_KEY=test_REPLACE_ME
YOUTUBE_API_KEY=test_REPLACE_ME

REDIS_URL=redis://localhost:6379

API_HOST=0.0.0.0
API_PORT=8001
CORS_ORIGINS=http://localhost:5173
