# Public frontend environment variables (Vite).
# WARNING: Any variable prefixed with VITE_ is embedded into the client bundle at build time.
# Do not place secrets here.

VITE_API_BASE_URL=http://localhost:8001
VITE_APP_NAME=SAVIQ
VITE_WEB_URL=http://localhost:5173
VITE_MOBILE_APP_URL=exp://127.0.0.1:8081

# Optional public integrations
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_public_anon_key
VITE_POSTHOG_API_KEY=replace_with_public_posthog_key
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
