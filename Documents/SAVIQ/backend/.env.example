# =============================================================================
# SAVIQ Backend Environment Template
# Copy this file to backend/.env for local development.
# Never commit real secrets.
# =============================================================================

# App + URLs/CORS -------------------------------------------------------------
APP_ENV=development
APP_NAME=SAVIQ
APP_URL=http://localhost:8001
WEB_URL=http://localhost:5173
MOBILE_APP_URL=exp://127.0.0.1:8081
# Comma-separated list, e.g. https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# Backward-compatible alias used by current backend runtime
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Auth / JWT ------------------------------------------------------------------
# BACKEND-ONLY: keep this secret and rotate regularly in non-local environments.
JWT_SECRET=replace_with_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_DAYS=7

# Database --------------------------------------------------------------------
# Preferred Mongo variables for operators:
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=saviq
MONGODB_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=20
# Backward-compatible aliases used by current backend runtime:
MONGO_URL=mongodb://localhost:27017
DB_NAME=expense_tracker
REDIS_URL=redis://localhost:6379/0

# Supabase --------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace_with_public_anon_key
# BACKEND-ONLY: never expose to web/mobile clients.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# OpenAI ----------------------------------------------------------------------
# Optional unless AI endpoints are enabled.
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_RECEIPT_MODEL=gpt-4.1-mini
OPENAI_INSIGHTS_MODEL=gpt-4.1-mini
OPENAI_RECEIPT_MAX_TOKENS=500
OPENAI_INSIGHTS_MAX_TOKENS=350
OPENAI_INSIGHTS_CATEGORY_LIMIT=6

# Anthropic -------------------------------------------------------------------
# Optional alternate provider for AI features.
ANTHROPIC_API_KEY=replace_with_anthropic_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# LemonSqueezy ----------------------------------------------------------------
# BACKEND-ONLY: keep API and webhook secrets server-side only.
LEMONSQUEEZY_API_KEY=replace_with_lemonsqueezy_api_key
LEMONSQUEEZY_STORE_ID=replace_with_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=replace_with_webhook_secret

# Cloudflare ------------------------------------------------------------------
# BACKEND-ONLY: token/key material must never be shipped to clients.
CLOUDFLARE_ACCOUNT_ID=replace_with_account_id
CLOUDFLARE_API_TOKEN=replace_with_api_token
CLOUDFLARE_R2_BUCKET=replace_with_bucket_name
CLOUDFLARE_R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=replace_with_r2_access_key
CLOUDFLARE_R2_SECRET_KEY=replace_with_r2_secret_key

# Email (Resend) --------------------------------------------------------------
RESEND_API_KEY=replace_with_resend_api_key
EMAIL_FROM=SAVIQ <no-reply@example.com>

# Analytics / Telemetry -------------------------------------------------------
POSTHOG_API_KEY=replace_with_posthog_key
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Storage / CDN ---------------------------------------------------------------
STORAGE_PROVIDER=r2
CDN_BASE_URL=https://cdn.example.com
UPLOADS_BUCKET=replace_with_upload_bucket

# Mobile app config placeholders ----------------------------------------------
# These are safe/public placeholders for local mobile app wiring.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# OAuth placeholders -----------------------------------------------------------
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com
APPLE_APP_ID=com.yourcompany.expensetracker

# Feature flags ----------------------------------------------------------------
ENABLE_AI_FEATURES=true
ENABLE_SUBSCRIPTIONS=false
ENABLE_WEEKLY_DIGEST=true

# Logging / runtime hardening -------------------------------------------------
LOG_LEVEL=INFO
REQUEST_LOGGING_ENABLED=true
RATE_LIMIT_ENABLED=true
SECURE_COOKIES=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
