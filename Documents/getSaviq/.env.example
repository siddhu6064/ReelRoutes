# ── Backend ────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
DB_NAME=expense_tracker

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# ── Google OAuth ───────────────────────────────────────────────────────────
# Comma-separated — add all platform client IDs you created in Google Cloud Console:
#   Web client ID       (for the web React app)
#   iOS client ID       (for the Expo iOS build)
#   Android client ID   (for the Expo Android build)
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com

# ── Apple Sign In ──────────────────────────────────────────────────────────
# Your app's bundle ID (mobile) or service ID (web), registered in Apple Developer
APPLE_APP_ID=com.yourcompany.expensetracker

# ── AI Features (optional) ────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_RECEIPT_MODEL=gpt-4.1-mini
OPENAI_INSIGHTS_MODEL=gpt-4.1-mini

# ── Web Frontend ──────────────────────────────────────────────────────────
VITE_BACKEND_URL=http://localhost:8001
# The Web OAuth client ID (same as the web one above, exposed to the browser)
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# ── Mobile Frontend ───────────────────────────────────────────────────────
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
