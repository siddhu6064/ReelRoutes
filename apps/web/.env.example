# ─────────────────────────────────────────────────────────────────────
# ReelRoutes Web — environment variables
# Copy to .env.local for local dev, set in Vercel dashboard for production.
# ─────────────────────────────────────────────────────────────────────

# ── API ──────────────────────────────────────────────────────────────
# Local dev: leave empty (Vite proxy in vite.config.ts handles /api)
# Production: your Railway API URL
VITE_API_URL=https://api.reelroutes.app

# ── Clerk ────────────────────────────────────────────────────────────
# Get from: dashboard.clerk.com → your app → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# ── Sentry (optional) ────────────────────────────────────────────────
VITE_SENTRY_DSN=https://...@o....ingest.sentry.io/...

# ── PostHog (optional) ───────────────────────────────────────────────
VITE_POSTHOG_KEY=phc_...
