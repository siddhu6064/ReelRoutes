# ─────────────────────────────────────────────────────────────────────────────
# ReelRoutes Web — STAGING environment variables
#
# Set these in Vercel → your staging project → Settings → Environment Variables.
# Select "Preview" environment only — never "Production".
#
# Staging Vercel project setup:
#   1. Import the same GitHub repo into a NEW Vercel project (call it "reelroutes-staging")
#   2. Set Root Directory to apps/web
#   3. Set these environment variables
#   4. The project auto-deploys from the siddhu6064 branch
# ─────────────────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────────────────
# Your Railway staging API URL — copy from Railway → staging project → Settings → Domains
VITE_API_URL=https://reelroutes-api-staging.railway.app

# ── Clerk — STAGING instance ─────────────────────────────────────────────────
# Use the pk_test_ key from your staging Clerk application.
# NEVER use pk_live_ here.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── Sentry ────────────────────────────────────────────────────────────────────
VITE_SENTRY_DSN=https://...@o....ingest.sentry.io/...

# ── PostHog ───────────────────────────────────────────────────────────────────
VITE_POSTHOG_KEY=phc_...

# ── Feature flags ─────────────────────────────────────────────────────────────
# Show a "STAGING" banner in the top-right corner of the UI
VITE_ENV=staging
