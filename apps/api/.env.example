# ─────────────────────────────────────────────────────────────────────
# ReelRoutes API — environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────
ENV=production
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=https://reelroutes.app,https://www.reelroutes.app

# ── MongoDB Atlas ────────────────────────────────────────────────────
# Get from: MongoDB Atlas → Database → Connect → Drivers
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=reelroutes_production

# ── Redis ────────────────────────────────────────────────────────────
# Railway provides this automatically when you add a Redis plugin.
# Or use Upstash: https://upstash.com
REDIS_URL=redis://default:<password>@<host>:6379

# ── Clerk ────────────────────────────────────────────────────────────
# Get from: dashboard.clerk.com → your app → API Keys
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_WEBHOOK_SECRET=whsec_...

# ── OpenAI ───────────────────────────────────────────────────────────
# Get from: platform.openai.com → API Keys
OPENAI_API_KEY=sk-...
OPENAI_EXTRACTION_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── Google ───────────────────────────────────────────────────────────
# One key covers: Places API, Maps JavaScript API, Routes API, Geocoding API
# Get from: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_PLACES_API_KEY=AIza...
YOUTUBE_API_KEY=AIza...

# ── Mapbox ───────────────────────────────────────────────────────────
# Get from: account.mapbox.com → Tokens
# Used for flyover map preview generation (W19)
MAPBOX_TOKEN=pk.eyJ1...

# ── Sentry ───────────────────────────────────────────────────────────
# Get from: sentry.io → your project → Settings → Client Keys (DSN)
SENTRY_DSN=https://...@o....ingest.sentry.io/...
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_RATE=0.1

# ── PostHog ──────────────────────────────────────────────────────────
# Get from: posthog.com → your project → Project Settings → Project API Key
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://app.posthog.com
