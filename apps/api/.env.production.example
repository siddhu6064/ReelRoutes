# ReelRoutes API — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is in .gitignore.

# ── App ───────────────────────────────────────────────────────
ENV=production                          # development | staging | production
VERSION=0.1.0

API_HOST=0.0.0.0
API_PORT=8000

# Allowed origins for CORS (comma-separated)
# Dev: http://localhost:5173,http://localhost:3000
# Prod: https://reelroutes.app,https://www.reelroutes.app
CORS_ORIGINS=https://reelroutes.app

# ── MongoDB ───────────────────────────────────────────────────
# Railway MongoDB or MongoDB Atlas connection string
# Atlas format: mongodb+srv://user:password@cluster.mongodb.net/reelroutes
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/reelroutes
MONGODB_DB=reelroutes

# ── Redis (ARQ job queue) ─────────────────────────────────────
# Upstash Redis (free tier) or Railway Redis
# Format: redis://default:PASSWORD@HOST:PORT
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# ── Clerk Auth ────────────────────────────────────────────────
# From: https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxx
# From: Clerk Dashboard → Webhooks → Add Endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# ── OpenAI ────────────────────────────────────────────────────
# From: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_EXTRACTION_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── Google ────────────────────────────────────────────────────
# From: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Places API, YouTube Data API v3, Maps JavaScript API
GOOGLE_PLACES_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Sentry ────────────────────────────────────────────────────
# From: https://sentry.io → Settings → Projects → Client Keys (DSN)
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_RATE=0.1

# ── PostHog analytics ─────────────────────────────────────────
# From: https://app.posthog.com → Project Settings → Project API Key
POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://app.posthog.com

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_IMPORTS_PER_DAY=10           # free tier: 10 imports/user/day
