# ─────────────────────────────────────────────────────────────────────────────
# ReelRoutes API — STAGING environment variables
#
# This file documents every variable needed for the staging Railway environment.
# Copy it to .env.staging (gitignored) for local staging simulation, OR
# paste each value into Railway → your staging project → Variables.
#
# Staging rules:
#   • Uses a SEPARATE MongoDB Atlas cluster / database (reelroutes_staging)
#   • Uses a SEPARATE Clerk application (dev instance)
#   • Uses the SAME OpenAI key as production (safe — different rate limits apply)
#   • Uses a SEPARATE Sentry environment tag so errors don't pollute prod alerts
#   • CORS allows the staging Vercel preview URL
#   • Free-tier import limit can be raised (e.g. 50/day) for QA testing
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
ENV=staging
VERSION=4.0.0

API_HOST=0.0.0.0
API_PORT=8000

# Staging Vercel preview URL + localhost for local QA
# Update with the actual Vercel preview URL after first deploy
CORS_ORIGINS=https://reelroutes-staging.vercel.app,http://localhost:5173,http://localhost:3000

# ── MongoDB Atlas — STAGING cluster ──────────────────────────────────────────
# Create a separate M0 free cluster named "reelroutes-staging" in Atlas.
# Database name must differ from production to prevent accidental data overlap.
MONGODB_URL=mongodb+srv://<user>:<password>@reelroutes-staging.<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=reelroutes_staging

# ── Redis (ARQ job queue) ─────────────────────────────────────────────────────
# Railway: add a Redis plugin to the staging project — it sets REDIS_URL automatically.
# Upstash: create a separate staging database at console.upstash.com
REDIS_URL=redis://default:<password>@<host>:6379

# ── Clerk — STAGING / DEV instance ───────────────────────────────────────────
# Create a NEW Clerk application for staging (or use the built-in "Development" instance).
# NEVER use production Clerk keys in staging — user data must stay separate.
# From: dashboard.clerk.com → your staging app → API Keys
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# From: Clerk Dashboard → Webhooks → Add Endpoint (point at staging Railway URL)
# Endpoint: https://your-staging-api.railway.app/api/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_...

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Same key as production is fine. Staging traffic is low-volume.
# Set a separate billing alert for staging to track spend independently.
OPENAI_API_KEY=sk-...
OPENAI_EXTRACTION_MODEL=gpt-4o
# Use gpt-4o-mini for chat in staging to keep costs low
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── Google ────────────────────────────────────────────────────────────────────
# Same key as production is fine — restrict by API referrer in GCP console.
GOOGLE_PLACES_API_KEY=AIza...
YOUTUBE_API_KEY=AIza...

# ── Mapbox ────────────────────────────────────────────────────────────────────
# Same token as production is fine — restrict by URL in Mapbox dashboard.
MAPBOX_TOKEN=pk.eyJ1...

# ── Sentry ────────────────────────────────────────────────────────────────────
# Same DSN as production — the SENTRY_ENVIRONMENT tag separates staging errors
# in the Sentry UI under Releases → staging vs production.
SENTRY_DSN=https://...@o....ingest.sentry.io/...
SENTRY_ENVIRONMENT=staging
# Higher traces rate in staging for better observability
SENTRY_TRACES_RATE=1.0

# ── PostHog ───────────────────────────────────────────────────────────────────
# Same key — staging events appear with distinct properties in PostHog.
# Or create a separate PostHog project for staging to keep dashboards clean.
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://app.posthog.com

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Higher limit for QA testers — QA needs to import many videos quickly.
RATE_LIMIT_IMPORTS_PER_DAY=50
