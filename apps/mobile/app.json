{
  "expo": {
    "name": "ReelRoutes",
    "slug": "reelroutes",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f0d"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.reelroutes.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ReelRoutes uses your location to show nearby places on your trip map.",
        "NSCameraUsageDescription": "ReelRoutes uses your camera to scan QR codes for trip sharing.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ReelRoutes tracks your location in the background to auto-mark stops as visited and draw your travel breadcrumb trail.",
        "NSLocationAlwaysUsageDescription": "ReelRoutes uses background location to auto-visit stops as you walk past them.",
        "UIBackgroundModes": ["location", "fetch"]
      },
      "appStoreUrl": "https://apps.apple.com/app/reelroutes/idXXXXXXXXXX",
      "entitlements": {
        "com.apple.security.application-groups": ["group.app.reelroutes.mobile"],
        "com.apple.developer.carplay-maps": true,
        "com.apple.developer.carplay-navigation": true
      }
    },
    "android": {
      "package": "app.reelroutes.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0f0d"
      },
      "intentFilters": [
        {
          "action": "android.intent.action.SEND",
          "data": [
            {
              "mimeType": "text/plain"
            }
          ],
          "category": ["android.intent.category.DEFAULT"]
        },
        {
          "action": "android.intent.action.VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.youtube.com"
            },
            {
              "scheme": "https",
              "host": "youtube.com"
            },
            {
              "scheme": "https",
              "host": "youtu.be"
            },
            {
              "scheme": "https",
              "host": "www.instagram.com"
            },
            {
              "scheme": "https",
              "host": "instagram.com"
            },
            {
              "scheme": "https",
              "host": "www.tiktok.com"
            },
            {
              "scheme": "https",
              "host": "tiktok.com"
            },
            {
              "scheme": "https",
              "host": "vm.tiktok.com"
            },
            {
              "scheme": "https",
              "host": "www.facebook.com"
            },
            {
              "scheme": "https",
              "host": "facebook.com"
            },
            {
              "scheme": "https",
              "host": "fb.watch"
            },
            {
              "scheme": "https",
              "host": "twitter.com"
            },
            {
              "scheme": "https",
              "host": "x.com"
            }
          ],
          "category": ["android.intent.category.DEFAULT", "android.intent.category.BROWSABLE"]
        },
        {
          "action": "android.intent.action.VIEW",
          "data": [
            {
              "scheme": "reelroutes"
            }
          ],
          "category": ["android.intent.category.DEFAULT", "android.intent.category.BROWSABLE"]
        }
      ],
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "iosShareExtensionName": "ReelRoutes Share",
          "iosAppGroupIdentifier": "group.app.reelroutes.mobile",
          "androidIntentFilters": ["text/*"],
          "androidMainActivityAttributes": {
            "android:launchMode": "singleTask"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "react-native-maps",
        {
          "googleMapsApiKey": "$(GOOGLE_MAPS_API_KEY)"
        }
      ]
    ],
    "scheme": "reelroutes",
    "experiments": {
      "typedRoutes": true
    }
  }
}
