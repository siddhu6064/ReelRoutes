# ============================================================
# ReelRoutes V4 — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values for local dev.
# Never commit .env — it is in .gitignore.
#
# Env tiers:
#   local   → .env (git-ignored, your local machine)
#   test    → .env.test (git-ignored, used by pytest / vitest)
#   staging → set in Railway / Vercel preview environments
#   prod    → set in Railway / Vercel production environments
# ============================================================

# ── Environment identifier ──────────────────────────────────
# One of: local | test | staging | production
ENV=local

# ── MongoDB ─────────────────────────────────────────────────
# Local: use a docker-compose instance or MongoDB Atlas free tier
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=reelroutes_local

# ── Clerk (Auth) ────────────────────────────────────────────
# Get from https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Webhook secret for Clerk → FastAPI user-sync webhooks
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── AI / LLM ────────────────────────────────────────────────
OPENAI_API_KEY=sk-REPLACE_ME
# Which model to use for extraction and chat
OPENAI_EXTRACTION_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── Google Places API ───────────────────────────────────────
GOOGLE_PLACES_API_KEY=REPLACE_ME

# ── YouTube Data API ────────────────────────────────────────
YOUTUBE_API_KEY=REPLACE_ME

# ── Instagram / TikTok / Scraping ───────────────────────────
# Optional: proxy or scraper service API key
SCRAPER_API_KEY=

# ── Redis (job queue) ───────────────────────────────────────
# Used by ARQ for async video processing jobs
REDIS_URL=redis://localhost:6379

# ── FastAPI ─────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# CORS origins allowed — comma-separated
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# ── React / Vite (web) ──────────────────────────────────────
# All VITE_ vars are exposed to the browser bundle
VITE_API_URL=http://localhost:8000
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
VITE_POSTHOG_KEY=phc_REPLACE_ME
VITE_POSTHOG_HOST=https://app.posthog.com
VITE_GOOGLE_MAPS_API_KEY=REPLACE_ME
VITE_SENTRY_DSN=

# ── Expo / React Native (mobile) ────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=REPLACE_ME
EXPO_PUBLIC_POSTHOG_KEY=phc_REPLACE_ME

# ── Sentry (error monitoring) ───────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── PostHog (analytics) ─────────────────────────────────────
POSTHOG_API_KEY=phc_REPLACE_ME
